# ============================================
# DnD AI: The Dungeon Master Server Configuration
# ============================================
# IMPORTANT: This file contains sensitive information and is ignored by Git!
# Copy .env.example to .env and fill in your actual values.

# ============================================
# Server Configuration
# ============================================
PORT=3000
HOST=0.0.0.0

# ============================================
# LLM API Configuration (OpenAI-compatible)
# ============================================
# Supports: LM Studio, Ollama, OpenAI, Azure, Together AI, Groq, etc.

# LM Studio (local, default)
# LLM_PROVIDER selects the wire protocol:
#   openai-compatible  -> /chat/completions (local runtimes and most vendors)
#   anthropic          -> Claude Messages API via the official SDK
LLM_PROVIDER=openai-compatible
LLM_API_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=local-model

# ============================================
# Alternative Providers (uncomment to use)
# ============================================

# OpenAI
# --- Claude (Anthropic) ---
# LLM_API_URL is unused for this provider; the SDK targets api.anthropic.com.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key
# LLM_MODEL=claude-opus-5

# --- OpenAI ---
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4

# Ollama (local, no auth required by default)
# LLM_API_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3

# Together AI
# LLM_API_URL=https://api.together.xyz/v1
# LLM_API_KEY=your_together_key
# LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct-Turbo

# Groq
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# LLM_MODEL=llama3-70b-8192

# Azure OpenAI (special format)
# LLM_API_URL=https://{resource}.openai.azure.com/openai/deployments/{model}/chat/completions?api-version=2024-02-01
# LLM_API_KEY=your_azure_key
# LLM_MODEL=

# Server logging: debug | info | warn | error
LOG_LEVEL=info

# Abort a stream after this many ms of silence (the timer resets on every
# chunk, so slow models are safe; only stalled streams abort).
LLM_IDLE_TIMEOUT_MS=45000
