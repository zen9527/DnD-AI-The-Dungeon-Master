# Configuration for the end-to-end run. The server reads this instead of the
# real .env because DND_ENV_FILE points here (see playwright.config.ts), so a
# test run never touches your provider, your key, or your port.
PORT=3210
HOST=127.0.0.1
LLM_PROVIDER=openai-compatible
LLM_API_URL=http://127.0.0.1:3199/v1
LLM_API_KEY=stub-key-not-a-secret
LLM_MODEL=stub-dm
